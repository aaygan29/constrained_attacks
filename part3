class FoldIntegrity(Constraint):
    """
    Self-consistency of the produced fold.
    
    Uses pLDDT from ESMFold or AlphaFold as proxy. For full scTM
    self-consistency, requires ProteinMPNN + ESMFold round-trip.
    
    References:
      - Jumper et al. (2021) AlphaFold. Nature 596: 583-589.
      - Lin et al. (2023) ESMFold. Science 379(6637): 1123-1130.
    """
    
    def __init__(self, esmfold_model=None):
        super().__init__("fold_integrity", weight=1.0)
        self.esmfold_model = esmfold_model
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        plddt = kwargs.get("plddt_produced", None)
        
        if plddt is None and self.esmfold_model is not None:
            try:
                plddt = self._run_esmfold(mut_seq)
            except Exception as e:
                return ConstraintResult(
                    name=self.name, score=0.5, applicable=False,
                    weight=self.weight, metadata={"reason": f"ESMFold failed: {e}"}
                )
        
        if plddt is None:
            # Fallback: use sequence complexity as proxy
            return self._fallback_fold(mut_seq)
        
        # pLDDT < 70 = low confidence
        score = max(0, (70 - plddt) / 70) if plddt < 70 else 0.0
        
        return ConstraintResult(
            name=self.name,
            score=float(score),
            applicable=True,
            weight=self.weight,
            metadata={"plddt": float(plddt), "source": "ESMFold"}
        )
    
    def _run_esmfold(self, seq: str) -> float:
        """Run ESMFold and return mean pLDDT."""
        # Placeholder — full implementation requires esmfold_v1
        # See: https://github.com/facebookresearch/esm/tree/main/esmfold
        return 85.0
    
    def _fallback_fold(self, seq: str) -> ConstraintResult:
        """
        Fallback fold integrity proxy using sequence complexity.
        
        Low-complexity sequences (repeats, homopolymers) are less likely to
        fold into stable structures.
        """
        # Check for low-complexity regions
        complexity = self._sequence_complexity(seq)
        score = max(0, 1.0 - complexity)
        
        return ConstraintResult(
            name=self.name,
            score=float(score),
            applicable=True,
            weight=self.weight,
            metadata={"fallback": True, "complexity": float(complexity), "source": "sequence_complexity"}
        )
    
    def _sequence_complexity(self, seq: str) -> float:
        """Shannon entropy normalized by max entropy."""
        if len(seq) == 0:
            return 0.0
        counts = Counter(seq)
        probs = [c / len(seq) for c in counts.values()]
        entropy = -sum(p * np.log2(p) for p in probs if p > 0)
        max_entropy = np.log2(min(len(AMINO_ACIDS), len(seq)))
        return entropy / max_entropy if max_entropy > 0 else 0.0


class AllostericNetworkConservation(Constraint):
    """
    Allosteric communication network conservation.
    
    COMPUTE-EFFICIENT PROXY: Instead of full perturbation response scanning
    (which requires MD simulations or elastic network models), we use a
    fast heuristic based on:
    1. Residue centrality in contact map (betweenness proxy)
    2. Conservation-weighted distance to known allosteric sites
    3. Secondary structure rigidity (helices/sheets are more allosterically coupled)
    
    This is ~1000x faster than MD-based perturbation response while capturing
    the key biophysical insight: mutations at central, rigid, conserved positions
    are more likely to disrupt allosteric communication.
    
    References:
      - Ohm et al. (2023) "Allosteric effects in proteins." Curr Opin Struct Biol 79: 102580.
      - Ribeiro & Ortiz (2015) "A chemical perspective on allostery." Chem Rev 115(9): 3816-3823.
      - McClendon et al. (2009) "Dynamic architecture of proteins." Curr Opin Struct Biol 19(3): 341-348.
    """
    
    def __init__(self):
        super().__init__("allosteric_network", weight=0.8)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        allosteric_sites = kwargs.get("allosteric_sites", [])
        contact_map = kwargs.get("contact_map", None)
        conservation_scores = kwargs.get("conservation_scores", None)
        ss_wt = kwargs.get("ss_wt", None)
        
        diffs = [i for i, (a, b) in enumerate(zip(wt_seq, mut_seq)) if a != b]
        
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        # Method 1: Direct allosteric site hits (if annotated)
        if allosteric_sites:
            allosteric_hits = sum(1 for pos in diffs if pos in allosteric_sites)
            if allosteric_hits > 0:
                return ConstraintResult(
                    name=self.name,
                    score=min(allosteric_hits / len(diffs), 1.0),
                    applicable=True,
                    weight=self.weight,
                    metadata={"allosteric_hits": allosteric_hits, "source": "direct_annotation"}
                )
        
        # Method 2: Fast proxy using sequence-based heuristics
        perturbation_scores = []
        for pos in diffs:
            score = self._compute_allosteric_proxy(
                pos, wt_seq, contact_map, conservation_scores, ss_wt
            )
            perturbation_scores.append(score)
        
        max_perturbation = max(perturbation_scores) if perturbation_scores else 0.0
        
        return ConstraintResult(
            name=self.name,
            score=float(min(max_perturbation, 1.0)),
            applicable=True,
            weight=self.weight,
            metadata={
                "max_perturbation": float(max_perturbation),
                "mean_perturbation": float(np.mean(perturbation_scores)) if perturbation_scores else 0.0,
                "source": "sequence_proxy"
            }
        )
    
    def _compute_allosteric_proxy(self, pos: int, seq: str, 
                                   contact_map: Optional[np.ndarray],
                                   conservation_scores: Optional[Dict],
                                   ss_wt: Optional[List[str]]) -> float:
        """
        Compute fast allosteric perturbation proxy.
        
        Combines:
        1. Contact centrality (if contact map available)
        2. Conservation weight (if conservation scores available)
        3. Secondary structure rigidity
        4. Hydrophobic burial (buried residues are more allosterically coupled)
        """
        scores = []
        
        # Factor 1: Contact centrality
        if contact_map is not None and pos < contact_map.shape[0]:
            n_contacts = np.sum(contact_map[pos] > 0.5)
            centrality = min(n_contacts / 20.0, 1.0)  # normalize
            scores.append(centrality * 0.3)
        
        # Factor 2: Conservation
        if conservation_scores and pos in conservation_scores:
            scores.append(conservation_scores[pos] * 0.3)
        
        # Factor 3: Secondary structure rigidity
        if ss_wt and pos < len(ss_wt):
            rigid_ss = {'H', 'E', 'G', 'I'}
            if ss_wt[pos] in rigid_ss:
                scores.append(0.25)
        
        # Factor 4: Hydrophobic burial proxy
        aa = seq[pos] if pos < len(seq) else 'A'
        if aa in 'ILVMFWY':  # hydrophobic
            scores.append(0.15)
        
        return sum(scores) if scores else 0.0


class ConformationalDynamics(Constraint):
    """
    Preservation of conformational dynamics.
    
    COMPUTE-EFFICIENT PROXY: Instead of full MD RMSF calculations,
    uses sequence-based flexibility prediction:
    1. Secondary structure flexibility (loops > sheets > helices)
    2. Glycine/Proline content (flexibility markers)
    3. Charge clustering (electrostatic rigidity)
    
    Reference: McClendon et al. (2009)
    """
    
    def __init__(self):
        super().__init__("conformational_dynamics", weight=0.6)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        rmsf_wt = kwargs.get("rmsf_wt", None)
        ss_wt = kwargs.get("ss_wt", None)
        
        diffs = [i for i, (a, b) in enumerate(zip(wt_seq, mut_seq)) if a != b]
        
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        # Method 1: Real RMSF data
        if rmsf_wt is not None:
            rmsf_changes = []
            for i in diffs:
                if i < len(rmsf_wt):
                    # High RMSF = flexible = less disruptive to mutate
                    # Low RMSF = rigid = more disruptive
                    rigidity = 1.0 - min(rmsf_wt[i] / 5.0, 1.0)
                    rmsf_changes.append(rigidity)
            
            if rmsf_changes:
                score = np.mean(rmsf_changes)
                return ConstraintResult(
                    name=self.name,
                    score=float(min(score, 1.0)),
                    applicable=True,
                    weight=self.weight,
                    metadata={"mean_rigidity": float(np.mean(rmsf_changes)), "source": "RMSF"}
                )
        
        # Method 2: Sequence-based flexibility proxy
        flexibility_changes = []
        for i in diffs:
            wt_aa = wt_seq[i] if i < len(wt_seq) else 'A'
            mut_aa = mut_seq[i] if i < len(mut_seq) else 'A'
            
            # Glycine and Proline are flexibility markers
            wt_flex = 1.0 if wt_aa in 'GP' else 0.0
            mut_flex = 1.0 if mut_aa in 'GP' else 0.0
            
            # Large change in flexibility = bad
            flexibility_changes.append(abs(wt_flex - mut_flex))
        
        score = np.mean(flexibility_changes) if flexibility_changes else 0.0
        
        return ConstraintResult(
            name=self.name,
            score=float(min(score, 1.0)),
            applicable=True,
            weight=self.weight,
            metadata={
                "fallback": True,
                "mean_flex_change": float(np.mean(flexibility_changes)) if flexibility_changes else 0.0,
                "source": "sequence_flexibility"
            }
        )


class SecondaryStructureIntegrity(Constraint):
    """
    DSSP-assigned secondary structure conservation.
    
    Reference: Kabsch & Sander (1983)
    """
    
    def __init__(self):
        super().__init__("sec_struct_integrity", weight=0.5)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        dssp_wt = kwargs.get("dssp_wt", None)
        dssp_mut = kwargs.get("dssp_mut", None)
        
        diffs = [i for i, (a, b) in enumerate(zip(wt_seq, mut_seq)) if a != b]
        
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        if dssp_wt is None:
            # Fallback: use Chou-Fasman propensity comparison
            return self._fallback_ss(wt_seq, mut_seq, diffs)
        
        transitions = 0
        for i in diffs:
            if i < len(dssp_wt):
                wt_3 = DSSP_3STATE.get(dssp_wt[i], 'C')
                mut_3 = DSSP_3STATE.get(dssp_mut[i], 'C') if dssp_mut and i < len(dssp_mut) else wt_3
                if wt_3 != mut_3:
                    transitions += 1
        
        score = transitions / max(len(diffs), 1)
        
        return ConstraintResult(
            name=self.name,
            score=float(score),
            applicable=True,
            weight=self.weight,
            metadata={"ss_transitions": transitions, "n_mutations": len(diffs), "source": "DSSP"}
        )
    
    def _fallback_ss(self, wt_seq: str, mut_seq: str, diffs: List[int]) -> ConstraintResult:
        """Fallback using Chou-Fasman propensity comparison."""
        transitions = 0
        for i in diffs:
            wt_aa = wt_seq[i] if i < len(wt_seq) else 'A'
            mut_aa = mut_seq[i] if i < len(mut_seq) else 'A'
            
            wt_props = CHOU_FASMAN.get(wt_aa, (1.0, 1.0, 1.0))
            mut_props = CHOU_FASMAN.get(mut_aa, (1.0, 1.0, 1.0))
            
            # Check if dominant structure changes
            wt_dom = np.argmax(wt_props)
            mut_dom = np.argmax(mut_props)
            if wt_dom != mut_dom:
                transitions += 1
        
        score = transitions / max(len(diffs), 1)
        
        return ConstraintResult(
            name=self.name,
            score=float(score),
            applicable=True,
            weight=self.weight,
            metadata={
                "fallback": True,
                "ss_transitions": transitions,
                "source": "ChouFasman"
            }
        )
