class Level1_Unconstrained(Constraint):
    """
    Level 1: No constraint. Always passes.
    
    Purpose: Baseline evasion rate with ZERO biological realism pressure.
    """
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        return ConstraintResult(
            name="unconstrained",
            score=0.0,
            applicable=True,
            weight=0.0,
            metadata={"edit_type": self._classify_edit(wt_seq, mut_seq)}
        )
    
    def _classify_edit(self, wt: str, mut: str) -> str:
        if len(wt) == len(mut):
            diffs = sum(1 for a, b in zip(wt, mut) if a != b)
            return f"point_mutation_n={diffs}"
        elif len(mut) > len(wt):
            return "insertion"
        else:
            return "deletion"


