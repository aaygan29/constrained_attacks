class ESM2_wt_marginal(Constraint):
    """
    ESM2 log-likelihood ratio: P(mut|context) / P(wt|context).
    
    Reference: Meier et al. (2021) "Language models enable zero-shot prediction
    of the effects of mutations on protein function." NeurIPS 34.
    """
    
    def __init__(self, model=None, alphabet=None, device="cuda"):
        super().__init__("esm2_wt_marginal", weight=1.0)
        self.device = device
        self.model = model
        self.alphabet = alphabet
        
        # Lazy initialization
        if model is None and ESM_AVAILABLE:
            try:
                self.model, self.alphabet = pretrained.load_model_and_alphabet("esm2_t33_650M_UR50D")
                self.model = self.model.to(device).eval()
                print("[ESM2] Model loaded successfully")
            except Exception as e:
                print(f"[ESM2] Failed to load model: {e}")
                self.model = None
                self.alphabet = None
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        if self.model is None or self.alphabet is None:
            return ConstraintResult(
                name=self.name, score=0.5, applicable=False,
                weight=self.weight, metadata={"reason": "ESM2 not available"}
            )
        
        try:
            wt_ll = self._pseudo_loglik(wt_seq)
            mut_ll = self._pseudo_loglik(mut_seq)
            log_ratio = mut_ll - wt_ll
            
            # Sigmoid normalization
            score = 1.0 / (1.0 + np.exp(-log_ratio * 0.5))
            
            return ConstraintResult(
                name=self.name,
                score=float(score),
                applicable=True,
                weight=self.weight,
                metadata={"wt_ll": float(wt_ll), "mut_ll": float(mut_ll), "log_ratio": float(log_ratio)}
            )
        except Exception as e:
            return ConstraintResult(
                name=self.name, score=0.5, applicable=False,
                weight=self.weight, metadata={"reason": f"ESM2 computation failed: {e}"}
            )
    
    def _pseudo_loglik(self, seq: str) -> float:
        """ESM2 pseudo-log-likelihood (masked marginal)."""
        batch_converter = self.alphabet.get_batch_converter()
        data = [("protein", seq)]
        _, _, tokens = batch_converter(data)
        tokens = tokens.to(self.device)
        
        with torch.no_grad():
            results = self.model(tokens, return_contacts=False)
        
        logits = results["logits"][0, 1:-1]
        target_tokens = tokens[0, 1:-1]
        log_probs = F.log_softmax(logits, dim=-1)
        
        pll = sum(log_probs[i, target_tokens[i]].item() for i in range(len(target_tokens)))
        return pll / len(target_tokens)


class GranthamDistance(Constraint):
    """
    Grantham chemical distance between amino acids.
    
    Reference: Grantham (1974)
    """
    
    def __init__(self):
        super().__init__("grantham", weight=0.3)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        diffs = [(a, b) for a, b in zip(wt_seq, mut_seq) if a != b]
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        distances = []
        for a, b in diffs:
            if a in GRANTHAM and b in GRANTHAM[a]:
                distances.append(GRANTHAM[a][b])
            else:
                distances.append(100)  # default for unknown pairs
        
        max_dist = 215.0
        score = np.mean(distances) / max_dist
        
        return ConstraintResult(
            name=self.name,
            score=float(min(score, 1.0)),
            applicable=True,
            weight=self.weight,
            metadata={"mean_distance": float(np.mean(distances)), "n_mutations": len(diffs)}
        )


class BLOSUM62Score(Constraint):
    """
    BLOSUM62 substitution score.
    
    Reference: Henikoff & Henikoff (1992)
    """
    
    def __init__(self):
        super().__init__("blosum62", weight=0.3)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        diffs = [(a, b) for a, b in zip(wt_seq, mut_seq) if a != b]
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        scores = []
        for a, b in diffs:
            if a in BLOSUM62 and b in BLOSUM62[a]:
                scores.append(BLOSUM62[a][b])
            else:
                scores.append(-4)
        
        score = 1.0 - (np.mean(scores) + 4) / 15
        
        return ConstraintResult(
            name=self.name,
            score=float(max(0, min(score, 1.0))),
            applicable=True,
            weight=self.weight,
            metadata={"mean_blosum": float(np.mean(scores)), "n_mutations": len(diffs)}
        )


class HydropathyChange(Constraint):
    """
    Change in Kyte-Doolittle hydropathy index.
    
    Reference: Kyte & Doolittle (1982)
    """
    
    def __init__(self):
        super().__init__("hydropathy", weight=0.2)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        diffs = [(a, b) for a, b in zip(wt_seq, mut_seq) if a != b]
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        changes = [abs(HYDROPATHY.get(a, 0) - HYDROPATHY.get(b, 0)) for a, b in diffs]
        max_change = 9.0
        score = np.mean(changes) / max_change
        
        return ConstraintResult(
            name=self.name,
            score=float(min(score, 1.0)),
            applicable=True,
            weight=self.weight,
            metadata={"mean_change": float(np.mean(changes)), "n_mutations": len(diffs)}
        )


class SecondaryStructurePropensity(Constraint):
    """
    Change in Chou-Fasman secondary structure propensity.
    
    Reference: Chou & Fasman (1974)
    """
    
    def __init__(self):
        super().__init__("sec_struct_propensity", weight=0.2)
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        diffs = [(a, b) for a, b in zip(wt_seq, mut_seq) if a != b]
        if not diffs:
            return ConstraintResult(name=self.name, score=0.0, applicable=True, weight=self.weight)
        
        changes = []
        for a, b in diffs:
            pa = np.array(CHOU_FASMAN.get(a, (1.0, 1.0, 1.0)))
            pb = np.array(CHOU_FASMAN.get(b, (1.0, 1.0, 1.0)))
            dist = np.linalg.norm(pa - pb)
            changes.append(dist)
        
        score = np.mean(changes) / 2.0
        return ConstraintResult(
            name=self.name,
            score=float(min(score, 1.0)),
            applicable=True,
            weight=self.weight,
            metadata={"mean_propensity_change": float(np.mean(changes))}
        )


