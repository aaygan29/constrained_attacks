# ==============================================================================
# SECTION 1: PROTO CORE PRIMITIVES
# ==============================================================================

class CombinationMode(Enum):
    """How individual constraint scores aggregate into a pass/fail decision."""
    ADDITIVE = "additive"           # Weighted average of applicable constraints
    MULTIPLICATIVE = "multiplicative"  # Product of applicable constraints (one zero = all zero)
    HARD_GATES = "hard_gates"       # Max of applicable constraints (any failure = failure)
    HYBRID = "hybrid"               # Category-wise multiplicative, within-category additive


@dataclass
class ConstraintResult:
    """Proto-standard return: one constraint's evaluation."""
    name: str
    score: float                    # 0.0 = keep (plausible), 1.0 = reject (implausible)
    applicable: bool                # Were required inputs present?
    weight: float = 1.0
    metadata: Dict = field(default_factory=dict)


@dataclass  
class PanelResult:
    """Full constraint panel evaluation."""
    constraint_results: List[ConstraintResult]
    aggregate_score: float
    n_applicable: int
    n_total: int
    combination_mode: CombinationMode
    passed: bool
    applicable_weights_sum: float


class Constraint(ABC):
    """Base class for all biological plausibility constraints."""
    
    def __init__(self, name: str, weight: float = 1.0):
        self.name = name
        self.weight = weight
    
    @abstractmethod
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> ConstraintResult:
        """Score the mutation. Return 0=keep, 1=reject."""
        pass


class ProtoPanel:
    """
    A collection of Constraints evaluated together.
    
    KEY FEATURE: Graceful degradation. If a constraint's required data is missing,
    it reports applicable=False and is EXCLUDED from the aggregate. Only
    applicable constraints contribute to the final score, with weights renormalized.
    
    Reference: Hie et al. (2026). "Proto: A Programming Language for Protein Design."
    """
    
    def __init__(self, constraints: List[Constraint], 
                 mode: CombinationMode = CombinationMode.HYBRID,
                 threshold: float = 0.5):
        self.constraints = constraints
        self.mode = mode
        self.threshold = threshold
    
    def evaluate(self, wt_seq: str, mut_seq: str, **kwargs) -> PanelResult:
        results = []
        applicable_scores = []
        applicable_weights = []
        
        for c in self.constraints:
            r = c.evaluate(wt_seq, mut_seq, **kwargs)
            results.append(r)
            if r.applicable:
                applicable_scores.append(r.score)
                applicable_weights.append(r.weight)
        
        n_applicable = len(applicable_scores)
        n_total = len(results)
        
        # Handle case where NO constraints are applicable
        if n_applicable == 0:
            return PanelResult(
                constraint_results=results,
                aggregate_score=0.5,  # neutral when no data
                n_applicable=0,
                n_total=n_total,
                combination_mode=self.mode,
                passed=True,  # pass by default when no constraints apply
                applicable_weights_sum=0.0
            )
        
        # Normalize weights to sum to 1.0 over applicable constraints
        total_weight = sum(applicable_weights)
        normalized_weights = [w / total_weight for w in applicable_weights]
        
        # Aggregate based on combination mode
        if self.mode == CombinationMode.ADDITIVE:
            aggregate = sum(s * w for s, w in zip(applicable_scores, normalized_weights))
        elif self.mode == CombinationMode.MULTIPLICATIVE:
            # Use geometric mean with normalized weights
            log_scores = [np.log(max(s, 1e-10)) * w for s, w in zip(applicable_scores, normalized_weights)]
            aggregate = np.exp(sum(log_scores))
        elif self.mode == CombinationMode.HARD_GATES:
            aggregate = max(applicable_scores)  # any failure = failure
        else:  # HYBRID
            aggregate = np.mean(applicable_scores)
        
        passed = aggregate < self.threshold
        
        return PanelResult(
            constraint_results=results,
            aggregate_score=aggregate,
            n_applicable=n_applicable,
            n_total=n_total,
            combination_mode=self.mode,
            passed=passed,
            applicable_weights_sum=total_weight
        )
    
    def get_applicable_constraints(self) -> List[str]:
        """Return names of constraints that were applicable in last evaluation."""
        # This is a helper for debugging
        return []


